{
  "name": "auth0-extension-tools",
  "version": "2.0.0",
  "description": "A set of tools and utilities to simplify the development of Auth0 Extensions.",
  "main": "src/index.js",
  "dependencies": {
    "async": "^3.2.6",
    "auth0": "^4.28.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "lru-memoizer": "^3.0.0",
    "promise-retry": "^2.0.1",
    "superagent": "^10.2.3",
    "webtask-tools": "^3.4.1"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^10.2.0",
    "mock-fs": "^5.5.0",
    "nock": "^14.0.9",
    "nyc": "^17.1.0"
  },
  "scripts": {
    "release": "git tag $npm_package_version && git push --tags && npm publish",
    "lint:js": "eslint --ignore-path .gitignore --ignore-pattern webpack .",
    "test": "mocha tests/**/*.js",
    "test:coverage": "nyc mocha tests/**/*.js && nyc report",
    "mocks:regenerate": "./scripts/regenerate-certs.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auth0-extensions/auth0-extension-tools.git"
  },
  "keywords": [
    "auth0",
    "extensions",
    "webtask"
  ],
  "author": "Auth0",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/auth0-extensions/auth0-extension-tools/issues"
  },
  "nyc": {
    "exclude": [
      "node_modules",
      "bin",
      "coverage",
      "tests/**"
    ]
  },
  "homepage": "https://github.com/auth0-extensions/auth0-extension-tools#readme"
}
